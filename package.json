    "generate-death-house-layers": "node scripts/generate-death-house-layers.mjs",
    "generate-map-layers": "node scripts/generate-map-layers.mjs",
    "generate-dungeon-level-layers": "node scripts/generate-map-layers.mjs death-house-dungeon-level"
  },
  "dependencies": {
    "three": "^0.172.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "obj2gltf": "^3.2.0",
    "sharp": "^0.35.3",
    "vite": "^6.0.7"
  }
