{
  "name": "dungeon-stage",
  "private": true,
  "version": "0.5.1",
  "description": "Dungeon Stage — project 3D monsters onto a box for D&D",
  "author": "Dungeon Stage",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
